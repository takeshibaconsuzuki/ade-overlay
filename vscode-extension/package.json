{
  "name": "ade",
  "displayName": "ADE",
  "description": "ADE integration for Visual Studio Code.",
  "version": "0.1.0",
  "private": true,
  "publisher": "ade",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "configuration": {
      "title": "ADE",
      "properties": {
        "ade.sidebar.worktreeCount": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "Number of other running worktrees listed in the ADE sidebar, in worktree picker order. `0` hides the list."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ade",
          "title": "ADE",
          "icon": "media/ade.svg"
        }
      ]
    },
    "views": {
      "ade": [
        {
          "type": "webview",
          "id": "ade.sidebar",
          "name": "ADE"
        }
      ]
    },
    "commands": [
      {
        "command": "ade.downloadEditor",
        "title": "Download...",
        "category": "ADE"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "command": "ade.downloadEditor",
          "when": "resourceScheme == vscode-remote",
          "group": "2_files@20"
        }
      ],
      "openEditors/context": [
        {
          "command": "ade.downloadEditor",
          "when": "resourceScheme == vscode-remote",
          "group": "2_files@20"
        }
      ],
      "commandPalette": [
        {
          "command": "ade.downloadEditor",
          "when": "resourceScheme == vscode-remote"
        }
      ]
    }
  }
}

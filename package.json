{
  "name": "ade-overlay",
  "productName": "ADE",
  "description": "A desktop workspace for agent-assisted development",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev:desktop": "electron-vite dev",
    "dev:server": "tsx src/server/index.ts",
    "build": "npm run build:desktop && npm run build:server && npm run build:extension",
    "build:desktop": "electron-vite build",
    "build:extension": "tsx scripts/build-extension.ts",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node24 --format=cjs --main-fields=module,main --outfile=out/server/index.cjs --external:bufferutil --external:utf-8-validate --external:@aws-sdk/client-s3 && node -e \"require('node:fs').copyFileSync('scripts/report-chat.mjs', 'out/server/report-chat.mjs')\"",
    "build:workbench": "tsx scripts/build-workbench.ts",
    "package": "npm run package:desktop && npm run package:server",
    "package:desktop": "npm run build:desktop && electron-builder --publish never",
    "package:server": "tsx scripts/package-server.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:package",
    "test:unit": "python -B -m unittest discover -s scripts -p test_*.py && tsx --test tests/*.test.ts",
    "test:integration": "npm run build && tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:package": "npm run package:server && tsx --test tests/packaging/*.test.ts",
    "lint": "eslint .",
    "format": "prettier . --write",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p vscode-extension/tsconfig.json --noEmit && tsc -p vscode-extension/tsconfig.webview.json --noEmit",
    "upgrade": "tsx scripts/upgrade.ts",
    "postinstall": "install-electron",
    "prebuild:server": "npm run build:workbench",
    "prepackage:server": "npm run build:workbench",
    "predev:server": "npm run build:workbench",
    "pretest:unit": "npm run build:workbench",
    "pretypecheck": "npm run build:workbench"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/themes": "3.3.0",
    "birpc": "4.2.0",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "env-paths": "4.0.0",
    "fastify": "5.12.5",
    "html-to-text": "10.0.1",
    "httpxy": "0.5.5",
    "jsonc-parser": "3.3.1",
    "p-retry": "8.0.1",
    "pino": "10.4.0",
    "powershell-utils": "0.2.1",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serialize-error": "13.0.2",
    "sharp": "0.35.5",
    "simple-git": "4.0.2",
    "superjson": "2.2.6",
    "tar": "7.5.22",
    "tree-kill": "1.2.2",
    "unzipper": "0.12.5",
    "write-file-atomic": "8.0.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unzipper": "0.10.11",
    "@types/vscode": "1.100.0",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vscode/vsce": "4.0.0",
    "@yao-pkg/pkg": "6.23.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "npm-check-updates": "23.1.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7"
  }
}

{
  "name": "ade-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:server && npm run build:extension",
    "build:extension": "tsc -p extensions/ade-terminals/tsconfig.json && node scripts/package-extension.mjs",
    "test:extension": "npm run build:extension && node scripts/test-extension.mjs",
    "build:server": "tsc -p tsconfig.server.json && node scripts/package-server.mjs",
    "server:dev": "node scripts/server-dev.mjs",
    "test": "node --experimental-strip-types --test tests/domain/*.test.ts tests/integration/*.test.ts tests/electron/*.test.ts tests/runtime/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json && tsc -p extensions/ade-terminals/tsconfig.json --noEmit",
    "upgrade": "node scripts/upgrade.mjs",
    "upgrade:vscode": "node scripts/upgrade-vscode.mjs",
    "postinstall": "install-electron",
    "package": "npm run build && node scripts/package-release.mjs",
    "package:dir": "npm run package -- --dir",
    "test:package": "node scripts/test-package.mjs",
    "test:runtime": "npm run build && node scripts/test-runtime.mjs",
    "pretest": "node scripts/settings-bridge-build.mjs",
    "setup": "npm run build:extension && node --experimental-strip-types src/server/index.ts --setup"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@radix-ui/themes": "3.3.0",
    "cheerio": "1.2.0",
    "cookie": "2.0.1",
    "cross-spawn": "7.0.6",
    "decompress-response": "10.0.0",
    "engine.io": "6.6.11",
    "execa": "10.0.1",
    "file-type": "22.1.1",
    "filenamify": "7.0.3",
    "http-proxy-3": "2.0.1",
    "idb": "8.0.3",
    "jsonc-parser": "3.3.1",
    "koffi": "3.3.2",
    "liquidjs": "10.29.0",
    "path-browserify-win32": "2.0.1",
    "pino": "10.3.1",
    "proper-lockfile": "4.1.2",
    "radix-ui": "1.6.7",
    "raw-body": "4.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "smol-toml": "1.9.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "systeminformation": "5.33.13",
    "tree-kill": "1.2.2",
    "which": "7.0.0",
    "write-file-atomic": "8.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@eslint/js": "10.0.1",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "25.9.3",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/vscode": "1.138.0",
    "@types/which": "3.0.4",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "@xterm/addon-serialize": "0.15.0-beta.301",
    "@xterm/headless": "6.1.0-beta.303",
    "archiver": "8.0.0",
    "electron": "42.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "license-checker-rseidelsohn": "4.4.2",
    "npm-check-updates": "22.2.3",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vite": "7.3.5",
    "ws": "8.21.3"
  },
  "description": "Worktree editors and provider terminals with an independent companion",
  "author": "ADE contributors",
  "homepage": "https://github.com/takeshibaconsuzuki/ade-overlay",
  "license": "UNLICENSED"
}

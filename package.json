{
  "name": "ade-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json && node scripts/package-server.mjs",
    "server": "npm run build:server && node out/server/server/index.js",
    "server:dev": "node --experimental-strip-types --watch src/server/index.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "upgrade": "NO_UPDATE_NOTIFIER=1 ncu --peer --removeRange -u && npm install",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0",
    "cheerio": "1.2.0",
    "cookie": "2.0.1",
    "cross-spawn": "7.0.6",
    "http-proxy-3": "2.0.1",
    "jsonc-parser": "3.3.1",
    "pino": "10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tree-kill": "1.2.2",
    "which": "7.0.0",
    "write-file-atomic": "8.0.0",
    "ws": "8.21.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/which": "3.0.4",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.4.0",
    "electron-vite": "5.0.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "npm-check-updates": "22.2.3",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vite": "7.3.5"
  }
}

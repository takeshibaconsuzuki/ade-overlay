{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "electron"]
  },
  "include": [
    "electron.vite.config.ts",
    "scripts/**/*.ts",
    "src/desktop/**/*.ts",
    "src/shared/**/*.ts",
    "src/server/**/*.ts",
    "tests/**/*.ts",
    "src/workbench/**/*.ts"
  ],
  "exclude": ["src/desktop/**/renderer/**"]
}
